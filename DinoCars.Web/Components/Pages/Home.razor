@page "/"

<PageTitle>Dino Cars – Garage in Alken</PageTitle>

<section class="hero">
    <div class="container">
        <p class="eyebrow">Garage in Alken</p>
        <h1>Uw auto in<br /><span>goede handen!</span></h1>
        <p class="lead">Onderhoud, herstellingen, banden, airco en meer. Vakkundig, eerlijk en betaalbaar.</p>
    </div>
</section>

<section id="diensten" class="section">
    <div class="container">
        <p class="eyebrow">Wat we doen</p>
        <h2>Onze diensten</h2>

        <ul class="services">
            @foreach (var service in Services)
            {
                <li class="service">@service</li>
            }
        </ul>
    </div>
</section>

<section class="section dark">
    <div class="container">
        <ul class="values">
            <li>Betrouwbaar</li>
            <li>Transparant</li>
            <li>Betaalbaar</li>
        </ul>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="cta-band">
            <h2>Liever even bellen?</h2>
            <p>
                Bel ons op <a href="@GarageInfo.PhoneLink">@GarageInfo.Phone</a> of stuur een bericht via
                <a href="@WhatsAppLink.Create(GarageInfo.Phone)" target="_blank" rel="noopener">WhatsApp</a>.
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] Services =
    [
        "Onderhoud & herstelling",
        "Olie verversen",
        "Airco invullen",
        "Diagnose",
        "Remmen",
        "Banden & velgen",
        "Autoruiten",
        "Auto poleren",
        "Auto's kopen & verkopen"
    ];
}