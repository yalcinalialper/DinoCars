@inherits LayoutComponentBase
@using DinoCars.Infrastructure.Identity

<header class="site-header">
    <div class="container header-inner">
        <a href="/" class="logo">DINO <span>CARS</span></a>

        @* Mobile menu: a hidden checkbox + its label open and close the menu without JavaScript.
           (wwwroot/js/nav.js only closes it again after a link is tapped.) *@
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu openen of sluiten" />
        <label for="nav-toggle" class="nav-toggle-label" aria-hidden="true"><span></span></label>

        <nav class="main-nav" aria-label="Hoofdmenu">
            <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
            <a href="/#diensten">Diensten</a>
            <NavLink href="occasies">Occasies</NavLink>
            <a href="/#contact">Contact</a>

            <AuthorizeView Roles="@AppRoles.Staff">
                <NavLink href="beheer">Beheer</NavLink>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <form action="Account/Logout" method="post" class="logout">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit">Uitloggen</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </nav>

        @* Outside the menu, so it's always visible, also on phones *@
        <NavLink href="afspraak" class="nav-cta">Afspraak maken</NavLink>
    </div>
</header>

<main>
    @Body
</main>

<footer class="site-footer" id="contact">
    <div class="container footer-grid">
        <div>
            <div class="logo">DINO <span>CARS</span></div>
            <p>Uw auto in goede handen!</p>
        </div>

        <div>
            <h3>Contact</h3>
            <p>
                <a href="@GarageInfo.PhoneLink">@GarageInfo.Phone</a><br />
                <a href="mailto:@GarageInfo.Email">@GarageInfo.Email</a><br />
                <a href="@GarageInfo.MapsLink" target="_blank" rel="noopener">@GarageInfo.Address</a>
            </p>
        </div>

        <div>
            <h3>Openingsuren</h3>
            <OpeningHours />
        </div>
    </div>

    <div class="container footer-bottom">
        © @DateTime.Now.Year @GarageInfo.Name · <a href="privacy">Privacy</a> · <a href="Account/Login">Login personeel</a>
    </div>
</footer>

<WhatsAppButton />

<div id="blazor-error-ui" data-nosnippet>
    Er is een onverwachte fout opgetreden.
    <a href="." class="reload">Herladen</a>
    <span class="dismiss">🗙</span>
</div>
